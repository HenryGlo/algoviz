<!DOCTYPE html>
<html lang="es">
<head>
  <title><%= content_for(:title) || "algoviz" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Algoritmos de ML y patrones de software animados paso a paso — el algoritmo emite un trace, el player lo reproduce.">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "algoviz", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body>
  <header>
    <%= link_to root_path, class: "brand" do %>algoviz<span>v0.4</span><% end %>
    <nav>
      <%= link_to "home", root_path %>
      <%= link_to "machine learning", category_path("machine-learning") %>
      <%= link_to "sorting", category_path("sorting") %>
      <%= link_to "rails · anti-patterns", category_path("rails-antipatterns") %>
    </nav>
    <a class="gh" href="https://github.com/HenryGlo/algoviz" target="_blank" rel="noopener">github</a>
  </header>
  <%= yield %>
</body>
</html>
