<%# Molde antes/después para patrones y anti-patrones de Rails.
    Los patrones "buenos" usan el mismo molde sin la sección "por qué duele". %>
<% snippets = @entry.code_snippets %>

<% if @entry.body.present? %>
  <section class="prose">
    <%= markdown(@entry.body) %>
  </section>
<% end %>

<% if snippets["antes"].present? || snippets["despues"].present? %>
  <section class="contrast">
    <% if snippets["antes"].present? %>
      <div class="contrast__col contrast__col--before">
        <h3 class="contrast__label">Antes</h3>
        <%= highlight_code(snippets["antes"], snippets["lang"].presence || "ruby") %>
      </div>
    <% end %>
    <% if snippets["despues"].present? %>
      <div class="contrast__col contrast__col--after">
        <h3 class="contrast__label">Después</h3>
        <%= highlight_code(snippets["despues"], snippets["lang"].presence || "ruby") %>
      </div>
    <% end %>
  </section>
<% end %>

<% if @entry.complexity.present? %>
  <aside class="note">
    <span class="note__label">Nota</span>
    <span class="note__value"><%= @entry.complexity %></span>
  </aside>
<% end %>
