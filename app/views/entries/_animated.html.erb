<section class="viz">
  <div class="viz__frame"
       data-controller="player"
       data-player-trace-value="<%= @entry.trace.to_json %>"
       data-player-renderer-value="<%= @entry.viz %>">
    <svg data-player-target="canvas" viewBox="0 0 460 260" class="viz__canvas" role="img"
         aria-label="Visualización de <%= @entry.title %>"></svg>

    <div class="controls">
      <button class="btn btn--primary" data-action="player#toggle">
        <span data-player-target="playLabel">Play</span>
      </button>
      <button class="btn" data-action="player#step">Paso</button>
      <button class="btn" data-action="player#reset">Reset</button>
      <label class="speed">
        <span>Velocidad</span>
        <input type="range" min="0" max="100" value="55" data-action="input->player#setSpeed">
      </label>
      <span class="controls__progress" data-player-target="progress">0 / 0</span>
    </div>
  </div>
</section>

<%= render "entries/code_tabs", entry: @entry %>

<% if @entry.complexity.present? %>
  <aside class="note">
    <span class="note__label">Complejidad</span>
    <code class="note__value"><%= @entry.complexity %></code>
  </aside>
<% end %>

<% if @entry.body.present? %>
  <section class="prose">
    <%= markdown(@entry.body) %>
  </section>
<% end %>
